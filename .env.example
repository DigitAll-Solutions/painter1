# Copy to .env.local and fill in. Everything server-only unless prefixed NEXT_PUBLIC_.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Read token: seed scripts, and live lead sending (reads the private leads.<location id> recipients)
SANITY_API_READ_TOKEN=
# Write token: saves every estimate request as a private lead document. Without it the estimate form
# can't save requests and visitors are asked to call instead. Use a dedicated token in Vercel.
SANITY_API_WRITE_TOKEN=
# Publish webhook secret: the same value as the secret on the Sanity webhook (docs/cms-guide.md,
# "Changes show right after publishing"). Without it /api/revalidate refuses every request and pages
# update within an hour instead of on the next visit.
SANITY_REVALIDATE_SECRET=

NEXT_PUBLIC_SITE_URL=https://www.painter1.com

# --- Free-estimate form -------------------------------------------------------------------------
# Cloudflare Turnstile (invisible widget). Leave both empty until the client's Turnstile account
# exists: Cloudflare's official always-pass TEST keys are used instead (site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA). In production that also logs a warning, because test
# keys block no bots. Add the real keys at launch; no code change needed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Brevo SMTP relay (docs/email-setup.md, section 3): Brevo → SMTP & API → SMTP tab. USER is the
# "Login" shown there (…@smtp-brevo.com), KEY a generated SMTP key. Leave empty until the account exists:
# nothing is sent and each lead is saved with email.status "skipped (no BREVO_SMTP_USER/BREVO_SMTP_KEY)"
# plus the exact subject and body it would have sent. Server-side only: never prefix with NEXT_PUBLIC_.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Brevo API key: not used for sending (the API turns text emails into HTML). Only for
# scripts/brevo-blocklist.ts, so .env.local only; not needed in Vercel.
BREVO_API_KEY=
# Sender: an address on painter1.com once the domain is authenticated in Brevo (e.g. leads@painter1.com).
# Brevo has no shared test sender, so nothing is sent (status "skipped") until this is set.
LEAD_FROM_EMAIL=
# Sender name shown in the inbox. Empty → "Painter1".
LEAD_FROM_NAME=

# Test mode (keep set until launch, in every environment): send ONLY to this address and add
# "[TEST]" to the subject.
LEAD_TEST_RECIPIENT=
# Second switch: real recipients are emailed only when LEAD_TEST_RECIPIENT is empty AND this is "true".
# Set to true only at go-live.
LEAD_SEND_LIVE=

# Daily lead cleanup (vercel.json cron → /api/cron/cleanup-leads; docs/cms-guide.md "Leads are kept
# 90 days"). Vercel sends this as "Authorization: Bearer <CRON_SECRET>"; any long random string, e.g.
# openssl rand -hex 32. Empty = the endpoint refuses every call (nothing is deleted).
CRON_SECRET=
# "true" = the cron only counts what it would delete (also: /api/cron/cleanup-leads?dryRun=1).
LEAD_CLEANUP_DRY_RUN=

# Google Tag Manager (e.g. GTM-PVDK2ZFJ, which also loads Attributer). Empty = not loaded.
NEXT_PUBLIC_GTM_ID=
